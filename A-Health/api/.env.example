# ============================================
# SelfHealth 环境变量配置
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入实际值
# 3. 确保 .env 已被 .gitignore 忽略
# ============================================

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=selfhealth
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# AI API 配置（DeepSeek）
AI_API_KEY=your_deepseek_api_key_here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.7

# AES 加密密钥（用于敏感健康数据加密存储）
AES_SECRET_KEY=your_aes_secret_key_at_least_16_chars

# JWT 签名密钥（建议使用 UUID 生成）
JWT_PRIVATE_KEY=your_jwt_private_key_here

# DeepSeek API 是否启用（余额不足时可设为 false）
DEEPSEEK_API_ENABLED=true
